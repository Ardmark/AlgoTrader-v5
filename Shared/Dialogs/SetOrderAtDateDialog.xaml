<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    x:Class="AlgoTrader.Shared.Windows.SetOrderAtDateDialog"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    WindowStartupLocation="CenterScreen" 
    SizeToContent="WidthAndHeight"
    MinWidth="300"
    MinHeight="100"
    WindowStyle="SingleBorderWindow"
    ResizeMode="CanMinimize">
    <StackPanel Margin="5">
        <Label>Enter date and time as dd/mm/yyyy hh:mm:ss</Label>
        <TextBox Name="date" Margin="5"/>
        <StackPanel Orientation="Horizontal" Margin="5" HorizontalAlignment="Right">

            <Button Content="_Ok" IsDefault="True" Margin="5" Name="btnOk" Click="BtnOk_Click" />
            <Button Content="_Cancel" IsCancel="True" Margin="5" Name="btnCancel" Click="BtnCancel_Click" />
        </StackPanel>
    </StackPanel>
</Window>
